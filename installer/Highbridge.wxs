<?xml version="1.0" encoding="utf-8"?>
<!--
  highbridge MSI. Built with WiX Toolset 5.0.2 (MS-RL, no Open Source Maintenance Fee; pinned in
  .config/dotnet-tools.json) by scripts/build-msi.ps1. Do not move to WiX 6 or later without
  settling the OSMF.

  Per-user package: no elevation prompt, installs to %LOCALAPPDATA%\Programs\Highbridge. Screens
  are in Dialogs.wxs, the license text in License.rtf. It uses no WiX extensions, so the MSI
  contains no WiX binaries.

  Properties (msiexec /i highbridge.msi NAME=value):
    AUTOSTART=0          don't start highbridge at sign-in
    LAUNCHAPP=0          don't start highbridge when the install finishes
    SKIPRUNTIMECHECK=1   install even if the .NET runtimes aren't found (custom .NET location)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="highbridge"
      Manufacturer="Pursuant Solutions"
      Version="$(var.ProductVersion)"
      UpgradeCode="A4E1C7B2-6D58-4F13-9C80-2B7E5A91D046"
      Scope="perUser"
      Language="1033"
      Compressed="yes">

    <SummaryInformation Description="highbridge - scan documents from web pages" />
    <!-- Same-version rebuilds replace each other instead of installing side by side. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of highbridge is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Icon for the Settings > Apps entry and the Start menu shortcut; Highbridge.exe embeds the same file. -->
    <Icon Id="highbridge.ico" SourceFile="$(sys.SOURCEFILEDIR)..\branding\highbridge.ico" />
    <Property Id="ARPPRODUCTICON" Value="highbridge.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="AUTOSTART" Value="1" />
    <Property Id="LAUNCHAPP" Value="1" />

    <!-- Framework-dependent build: needs the x86 .NET Desktop Runtime and ASP.NET Core Runtime 10.
         The x86 runtimes always live under the 32-bit Program Files folder. -->
    <Property Id="DESKTOPRUNTIME">
      <DirectorySearch Id="DesktopRuntimeVersions" Path="[ProgramFilesFolder]dotnet\shared\Microsoft.WindowsDesktop.App" Depth="1">
        <FileSearch Name="PresentationFramework.dll" MinVersion="10.0.0.0" MaxVersion="10.65535.65535.65535" />
      </DirectorySearch>
    </Property>
    <Property Id="ASPNETRUNTIME">
      <DirectorySearch Id="AspNetRuntimeVersions" Path="[ProgramFilesFolder]dotnet\shared\Microsoft.AspNetCore.App" Depth="1">
        <FileSearch Name="Microsoft.AspNetCore.dll" MinVersion="10.0.0.0" MaxVersion="10.65535.65535.65535" />
      </DirectorySearch>
    </Property>
    <!-- With the full UI, PT_RuntimeDlg handles a missing runtime (with download buttons) and never
         lets the install continue. This message is for basic UI and silent installs. It lives in a
         property because LaunchCondition.Description holds only 255 characters (ICE03); the column
         is formatted, so [PT_RuntimeMissingMessage] expands at run time. -->
    <Property Id="PT_RuntimeMissingMessage" Value="highbridge can't be installed yet. First install these two free Microsoft components, in their 32-bit (x86) versions (also on 64-bit Windows):&#13;&#10;&#13;&#10;1. .NET Desktop Runtime 10 (x86):&#13;&#10;https://aka.ms/dotnet/10.0/windowsdesktop-runtime-win-x86.exe&#13;&#10;&#13;&#10;2. ASP.NET Core Runtime 10 (x86):&#13;&#10;https://aka.ms/dotnet/10.0/aspnetcore-runtime-win-x86.exe&#13;&#10;&#13;&#10;Then run this highbridge installer again." />
    <Launch
        Condition="Installed OR SKIPRUNTIMECHECK OR (DESKTOPRUNTIME AND ASPNETRUNTIME) OR UILevel = 5"
        Message="[PT_RuntimeMissingMessage]" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Highbridge" />
      </Directory>
    </StandardDirectory>

    <!-- Per-user components use HKCU key paths (ICE38/ICE43) and remove their folders (ICE64).
         Other components refer to the exe as [INSTALLFOLDER]Highbridge.exe, not [#HighbridgeExe],
         because a file reference from another component is an ICE69 warning. -->
    <ComponentGroup Id="AppComponents" Directory="INSTALLFOLDER">
      <Component Id="App" Guid="C3B8E14A-7F02-4D6E-8A55-91D0C4E27B18">
        <File Id="HighbridgeExe" Source="$(var.PublishDir)\Highbridge.exe" KeyPath="no" />
        <RegistryValue Root="HKCU" Key="Software\Pursuant Solutions\highbridge" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
        <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
      </Component>

      <!-- Same keys as the app's own register switch (WindowsRegistration.cs). -->
      <Component Id="ProtocolHandler" Guid="5E9A2D70-1C44-4B8F-A637-0F8D2C6B91AE">
        <RegistryKey Root="HKCU" Key="Software\Classes\highbridge">
          <RegistryValue Type="string" Value="URL:highbridge scanning" KeyPath="yes" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
          <RegistryValue Key="DefaultIcon" Type="string" Value="&quot;[INSTALLFOLDER]Highbridge.exe&quot;,0" />
          <RegistryValue Key="shell\open\command" Type="string" Value="&quot;[INSTALLFOLDER]Highbridge.exe&quot; &quot;%1&quot;" />
        </RegistryKey>
      </Component>

      <!-- The tray menu's "Start when I sign in" toggles the same Run value, so it is not the key path. -->
      <Component Id="AutoStart" Guid="8D17F3C6-52AB-4E90-B214-6A9C0E5F73D2" Condition="AUTOSTART = &quot;1&quot;">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="Highbridge" Type="string" Value="&quot;[INSTALLFOLDER]Highbridge.exe&quot; --background" />
        <RegistryValue Root="HKCU" Key="Software\Pursuant Solutions\highbridge" Name="AutoStart" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="F06C4A89-3E71-4D25-9B58-7C1A2E84D6F0">
        <Shortcut Id="HighbridgeShortcut" Name="highbridge" Description="Scan documents from web pages" Target="[INSTALLFOLDER]Highbridge.exe" WorkingDirectory="INSTALLFOLDER" Icon="highbridge.ico" />
        <RegistryValue Root="HKCU" Key="Software\Pursuant Solutions\highbridge" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <UIRef Id="HighbridgeUI" />

    <Feature Id="Main" Title="highbridge">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>

    <!-- Plain EXE custom actions (no WiX custom-action DLLs). The exit switch asks the running
         tray app to quit and waits for it, so upgrades and uninstalls never hit files in use. -->
    <CustomAction Id="StopRunningHighbridge" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]Highbridge.exe&quot; --exit" Execute="immediate" Return="ignore" />
    <CustomAction Id="StartHighbridge" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]Highbridge.exe&quot; --background" Execute="immediate" Return="asyncNoWait" />
    <InstallExecuteSequence>
      <Custom Action="StopRunningHighbridge" Before="InstallValidate" Condition="Installed OR WIX_UPGRADE_DETECTED" />
      <Custom Action="StartHighbridge" After="InstallFinalize" Condition="LAUNCHAPP = &quot;1&quot; AND NOT (REMOVE ~= &quot;ALL&quot;)" />
    </InstallExecuteSequence>
  </Package>
</Wix>
